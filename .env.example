# Client-side monitoring (values prefixed with VITE_ are public in the browser)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_VERSION=

# Activity notification emails (enabled by default; set to false to skip without later delivery)
ACTIVITY_EMAIL_NOTIFICATIONS_ENABLED=true

# AI (use a standard OpenAI key, or the platform-provided Forge variables)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# Optional Sentry sourcemap upload during production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
